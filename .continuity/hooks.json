{
  "description": "Continuity Stage 0 hooks. Advisory only: none of them can block or continue a turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.continuity/scripts/hook-prompt.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.continuity/scripts/hook-precompact.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.continuity/scripts/hook-sessionend.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
